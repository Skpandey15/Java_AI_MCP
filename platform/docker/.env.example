# Copy to platform/docker/.env. Never commit the real file.
APP_ENVIRONMENT=local
LOG_LEVEL=INFO
OPENAI_API_KEY=replace-with-your-openai-api-key
LITELLM_MASTER_KEY=replace-with-a-long-random-internal-key
AI_SERVICE_TOKEN=replace-with-another-long-random-internal-key
INPUT_COST_PER_MILLION_TOKENS_USD=0.15
OUTPUT_COST_PER_MILLION_TOKENS_USD=0.60
MCP_AUTHORIZATION_SECRET=replace-with-at-least-32-random-characters
MCP_EXECUTION_TIMEOUT_SECONDS=10
MCP_CALLS_PER_MINUTE=20
DATABASE_MAX_POOL_SIZE=20
DOWNSTREAM_MAX_ATTEMPTS=3
DOWNSTREAM_RETRY_DELAY_MS=200
DOWNSTREAM_CIRCUIT_FAILURE_THRESHOLD=5
DOWNSTREAM_CIRCUIT_OPEN_SECONDS=30
TRACING_SAMPLING_PROBABILITY=1.0
