{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "title": "Orchestrator availability",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"interview-orchestrator\"}", "refId": "A"}],
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}
    },
    {
      "title": "HTTP 5xx ratio",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "service:http_errors:ratio5m", "refId": "A"}],
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 0}
    },
    {
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "service:http_latency:p95_5m", "refId": "A"}],
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 0}
    },
    {
      "title": "MCP calls and failures",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(mcp_tool_calls_total[5m]))", "legendFormat": "calls", "refId": "A"},
        {"expr": "sum(rate(mcp_tool_failures_total[5m]))", "legendFormat": "failures", "refId": "B"}
      ],
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 6}
    },
    {
      "title": "RAG generation outcomes",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (outcome) (rate(rag_generation_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 6}
    },
    {
      "title": "AI generation latency p95",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(ai_question_generation_latency_seconds_bucket[15m])))", "refId": "A"}],
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 13}
    },
    {
      "title": "AI token usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (direction) (rate(ai_question_generation_tokens_total[5m]))", "legendFormat": "{{direction}}", "refId": "A"}],
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 13}
    },
    {
      "title": "AI estimated cost",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(ai_question_generation_estimated_cost_usd_total[1h]))", "legendFormat": "USD/hour", "refId": "A"}],
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 13}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 40,
  "tags": ["phase-6", "slo", "ai-quality"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Online Interview Platform Overview",
  "uid": "online-interview-overview",
  "version": 1
}
