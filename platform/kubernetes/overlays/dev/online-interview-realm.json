{
    "realm":  "online-interview",
    "enabled":  true,
    "registrationAllowed":  true,
    "registrationEmailAsUsername":  true,
    "loginWithEmailAllowed":  true,
    "otpPolicyType": "totp",
    "otpPolicyAlgorithm": "HmacSHA1",
    "otpPolicyDigits": 6,
    "otpPolicyPeriod": 30,
    "otpPolicyLookAheadWindow": 1,
    "verifyEmail":  true,
    "bruteForceProtected": true,
    "failureFactor": 5,
    "waitIncrementSeconds": 60,
    "maxFailureWaitSeconds": 900,
    "accessTokenLifespan": 300,
    "ssoSessionIdleTimeout": 1800,
    "ssoSessionMaxLifespan": 28800,
    "revokeRefreshToken": true,
    "refreshTokenMaxReuse": 0,
    "eventsEnabled": true,
    "adminEventsEnabled": true,
    "adminEventsDetailsEnabled": true,
    "roles":  {
                  "realm":  [
                                {
                                    "name":  "candidate",
                                    "description":  "Candidate platform access"
                                },
                                {
                                    "name":  "interviewer",
                                    "description":  "Administratively assigned interviewer access"
                                },
                                {
                                    "name":  "platform_admin",
                                    "description":  "Restricted identity provisioning administration"
                                }
                            ]
              },
    "defaultRole":  {
                        "name":  "default-roles-online-interview",
                        "composite":  true,
                        "composites":  {
                                           "realm":  [
                                                         "offline_access",
                                                         "uma_authorization",
                                                         "candidate"
                                                     ]
                                       }
                    },
    "clients":  [
                    {
                        "clientId":  "online-interview-web",
                        "name":  "Online Interview Web",
                        "enabled":  true,
                        "publicClient":  true,
                        "standardFlowEnabled":  true,
                        "directAccessGrantsEnabled":  false,
                        "rootUrl":  "https://dev.interview.192.168.1.6.nip.io:8443",
                        "baseUrl":  "https://dev.interview.192.168.1.6.nip.io:8443",
                        "redirectUris":  [
                                             "https://dev.interview.192.168.1.6.nip.io:8443/*"
                                         ],
                        "webOrigins":  [
                                           "https://dev.interview.192.168.1.6.nip.io:8443"
                                       ],
                        "attributes":  {
                                           "pkce.code.challenge.method":  "S256"
                                       },
                        "protocolMappers":  [
                                                {
                                                    "name":  "tenant-id",
                                                    "protocol":  "openid-connect",
                                                    "protocolMapper":  "oidc-usermodel-attribute-mapper",
                                                    "consentRequired":  false,
                                                    "config":  {
                                                                   "user.attribute":  "tenant_id",
                                                                   "claim.name":  "tenant_id",
                                                                   "jsonType.label":  "String",
                                                                   "multivalued":  "false",
                                                                   "access.token.claim":  "true",
                                                                   "id.token.claim":  "true",
                                                                   "userinfo.token.claim":  "true"
                                                               }
                                                },
                                                {
                                                    "name": "api-audience",
                                                    "protocol": "openid-connect",
                                                    "protocolMapper": "oidc-audience-mapper",
                                                    "consentRequired": false,
                                                    "config": {
                                                        "included.client.audience": "online-interview-web",
                                                        "access.token.claim": "true",
                                                        "id.token.claim": "false"
                                                    }
                                                }
                                            ]
                    }
                ]
}
