{
  "realm": "online-interview",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": false,
  "roles": {
    "realm": [
      { "name": "candidate", "description": "Candidate platform access" },
      { "name": "interviewer", "description": "Administratively assigned interviewer access" }
    ]
  },
  "defaultRole": {
    "name": "default-roles-online-interview",
    "composite": true,
    "composites": {
      "realm": ["offline_access", "uma_authorization", "candidate"]
    }
  },
  "clients": [
    {
      "clientId": "online-interview-web",
      "name": "Online Interview Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "http://interview.localhost:8081",
      "baseUrl": "http://interview.localhost:8081",
      "redirectUris": ["http://interview.localhost:8081/*", "http://localhost:30080/*"],
      "webOrigins": ["http://interview.localhost:8081", "http://localhost:30080"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ]
}
