# Local-only: containerizes a pre-built bootJar (built on the host with cached Gradle deps)
# to avoid re-downloading the full dependency graph inside Docker. Mirrors the runtime
# stage of the production Dockerfile.
FROM eclipse-temurin:21-jre-alpine
RUN apk upgrade --no-cache
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY build/libs/interview-orchestrator-*.jar app.jar
USER app
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
